{
  "name": "sm-app-template",
  "version": "0.1.0",
  "private": true,
  "description": "SourceMedium App Starter: a customer-owned Next.js app on your SourceMedium warehouse.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "setup:agent": "node scripts/setup-agent.mjs",
    "dev": "tsx --conditions=react-server scripts/diagnose.ts --offline && next dev --hostname 127.0.0.1 --port 3000",
    "diagnose": "tsx --conditions=react-server scripts/diagnose.ts",
    "schema": "tsx --conditions=react-server scripts/schema.ts",
    "check": "tsx scripts/check.ts",
    "skills:sync": "tsx scripts/skills-sync.ts",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache .",
    "lint": "eslint --cache --max-warnings 0 .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:e2e": "next build && playwright test",
    "test:secrets": "tsx scripts/check-secret-isolation.ts",
    "build": "next build",
    "build:cloudflare": "tsx scripts/build-cloudflare.ts",
    "preview": "tsx --conditions=react-server scripts/diagnose.ts --dev-vars && pnpm build:cloudflare && opennextjs-cloudflare preview",
    "deploy": "pnpm build:cloudflare && opennextjs-cloudflare deploy",
    "deploy:preview": "pnpm build:cloudflare && wrangler preview --env preview",
    "prepare": "simple-git-hooks",
    "smoke:worker": "tsx scripts/smoke-worker.ts",
    "test:live": "next build && SM_LIVE_E2E=1 playwright test",
    "test:hosted": "node scripts/test-hosted.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.8",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jose": "6.2.12",
    "lucide-react": "1.52.0",
    "next": "15.5.27",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20261006.1",
    "@eslint/js": "10.0.1",
    "@next/env": "15.5.27",
    "@next/eslint-plugin-next": "15.5.27",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.12.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "27.4.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "simple-git-hooks": "2.14.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged --quiet || true"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}

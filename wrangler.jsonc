{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Rename freely; the Deploy to Cloudflare button sets it to your project's name.
  "name": "sm-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Files from public/ pass the viewer guard like pages do. Only the build's
    // hashed chunks (no data) skip the Worker.
    "run_worker_first": ["/*", "!/_next/static/*"],
  },
  "observability": { "logs": { "enabled": true } },
  // Preserve runtime settings such as APP_STORE_ID across ordinary deploys.
  // Removing one deliberately means deleting it from the Worker's settings.
  "keep_vars": true,
  // Runtime configuration (SM_APP_KEY, APP_BASIC_AUTH, and the rest of the
  // block from SourceMedium) lives in your Worker's encrypted variables, never
  // here: declaring them here, even empty, would overwrite them on deploy.
  // See docs/connect.md.
  // The shared password protects every hostname, so workers.dev is safe with
  // Basic. With Cloudflare Access, cover workers.dev too or turn it off
  // (docs/auth.md). Version URLs stay off: they use production bindings.
  "workers_dev": true,
  "preview_urls": false,
  // The preview environment gets its own Worker, named <name>-preview by
  // Wrangler. Connect it separately to Git (docs/cloud.md). Its branch/version
  // URLs contain sample data only. Keep the live
  // Worker's extra URLs disabled above; both kinds use the same URL switch.
  "env": {
    "preview": {
      "workers_dev": false,
      "preview_urls": true,
      "previews": {},
    },
  },
}

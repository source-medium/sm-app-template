{
  "$schema": "node_modules/wrangler/config-schema.json",
  // A unique Worker name for this app (docs/connect.md); keep it once deployed.
  "name": "sm-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Files from public/ pass the viewer guard like pages do. Only the build's
    // hashed chunks (no data) skip the Worker.
    "run_worker_first": ["/*", "!/_next/static/*"],
  },
  "observability": { "logs": { "enabled": true } },
  // Preserve runtime settings such as APP_STORE_ID across ordinary deploys.
  // Removing one deliberately means deleting it from the Worker's settings.
  "keep_vars": true,
  // Runtime configuration (SM_APP_KEY, APP_BASIC_AUTH, and the rest of the
  // block from SourceMedium) lives in your Worker's encrypted variables, never
  // here: declaring them here, even empty, would overwrite them on deploy.
  // See docs/connect.md.
  // The shared password protects every hostname, so workers.dev is safe with
  // Basic. With Cloudflare Access, cover workers.dev too or turn it off
  // (docs/auth.md). Version URLs stay off: they use production bindings.
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "APP_ENVIRONMENT": "production" },
  // Optional: keep the query cache across Worker restarts and locations
  // (docs/cloud.md#query-cache). Create the namespace, paste its id, and
  // uncomment. Without it the cache is memory only; nothing else changes.
  // "kv_namespaces": [{ "binding": "APP_QUERY_CACHE", "id": "<id from wrangler kv namespace create>" }],
  // Previews and optional agent debugging share the Development app credential.
  // Set its complete block in <name>-preview > Settings > Previews Base once.
  // Branch previews receive those secrets when created, not on every update.
  // Missing configuration fails closed instead of displaying sample numbers.
  // Keep production Version URLs disabled; its credential stays separate.
  "env": {
    "preview": {
      "workers_dev": false,
      "preview_urls": true,
      "vars": { "APP_REQUIRE_LIVE": "true", "APP_ENVIRONMENT": "preview" },
      // "kv_namespaces": [{ "binding": "APP_QUERY_CACHE", "id": "<id from wrangler kv namespace create --env preview>" }],
      "previews": {
        "vars": { "APP_REQUIRE_LIVE": "true", "APP_ENVIRONMENT": "preview" },
      },
    },
  },
}

# SourceMedium App Starter configuration. Placeholders only; never put real values in this file.
#
# Leave every value empty to run on sample data. To use your warehouse, paste the
# block an organization admin creates on the Apps page of your SourceMedium
# workspace. See docs/connect.md. The block goes into .env.local (git-ignored)
# for local work and into your host's runtime variables for the deployed app.
# The Deploy to Cloudflare button asks for each value below as a secret.

# Stable app id; also the sm_app label on every BigQuery job.
SM_APPLICATION_ID=
# The SourceMedium project that runs (and pays for) the app's queries.
BIGQUERY_JOB_PROJECT_ID=
# Where your datasets live, such as US.
BIGQUERY_LOCATION=
# Your warehouse coordinates, exactly as issued.
SM_DATA_PROJECT_ID=
SM_TRANSFORMED_DATASET_ID=
SM_METADATA_DATASET_ID=
# Base64 Google service-account key. Secret.
SM_APP_KEY=
# Shared viewer password as user:password. Secret. Required with live data, even locally.
# The password part is 24 to 128 letters, digits, - or _; the issued block already fits.
APP_BASIC_AUTH=

# Optional: per-person sign-in with Cloudflare Access instead of the shared password
# (remove APP_BASIC_AUTH when you set these; see docs/auth.md).
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=
#
# Optional: per-query scan ceiling in bytes (default 1 GiB).
# BIGQUERY_MAX_BYTES_BILLED=
#
# Optional: restrict this deployment to one exact sm_store_id. Empty/unset allows all stores.
# APP_STORE_ID=your-store-id
# Use a separate deployment and viewer guard for each store. See docs/auth.md.

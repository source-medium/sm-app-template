{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "number",
      "const": 1
    },
    "app": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": ["id", "name"],
      "additionalProperties": false
    },
    "organization": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": ["id", "name"],
      "additionalProperties": false
    },
    "principal": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["viewer", "developer_token"]
            },
            "user_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["kind", "user_id"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "verifier"
            },
            "user_id": {
              "type": "null"
            }
          },
          "required": ["kind", "user_id"],
          "additionalProperties": false
        }
      ]
    },
    "warehouse": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "transformed_dataset": {
          "type": "string",
          "minLength": 1
        },
        "metadata_dataset": {
          "type": "string",
          "minLength": 1
        },
        "allowed_datasets": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "project_id",
        "transformed_dataset",
        "metadata_dataset",
        "allowed_datasets"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "default_rows": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_rows": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "timeout_ms": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_bytes_billed": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_response_bytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_parameters": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "default_rows",
        "max_rows",
        "timeout_ms",
        "max_bytes_billed",
        "max_response_bytes",
        "max_parameters"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_version",
    "app",
    "organization",
    "principal",
    "warehouse",
    "limits"
  ],
  "additionalProperties": false
}

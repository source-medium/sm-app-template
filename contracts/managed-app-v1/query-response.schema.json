{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "number",
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Field"
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "$ref": "#/$defs/Cell"
        }
      }
    },
    "truncated": {
      "type": "boolean"
    },
    "receipt": {
      "type": "object",
      "properties": {
        "job": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "project_id": {
                  "type": "string"
                },
                "job_id": {
                  "type": "string"
                },
                "location": {
                  "type": "string"
                }
              },
              "required": ["project_id", "job_id", "location"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "query_id": {
          "type": ["string", "null"]
        },
        "bytes_billed": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "cache_hit": {
          "type": ["boolean", "null"]
        }
      },
      "required": ["job", "query_id", "bytes_billed", "cache_hit"],
      "additionalProperties": false
    },
    "fetched_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "contract_version",
    "request_id",
    "fields",
    "rows",
    "truncated",
    "receipt",
    "fetched_at"
  ],
  "additionalProperties": false,
  "$defs": {
    "Field": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": ["NULLABLE", "REQUIRED", "REPEATED"]
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Field"
          }
        }
      },
      "required": ["name", "type", "mode"],
      "additionalProperties": false
    },
    "Cell": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Cell"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Cell"
          }
        }
      ]
    }
  }
}
